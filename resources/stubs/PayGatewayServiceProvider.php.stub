<?php

namespace App\Providers;

use Illuminate\Support\Facades\Route;
use Illuminate\Support\ServiceProvider;
use Qionar\PayGateway\Controllers\Contracts\HandleWebhookCallbacks;

class PayGatewayServiceProvider extends ServiceProvider
{
    public function register()
    {
        $drivers = config('pay-gateway.drivers');

        foreach ($drivers as $driver) {
            $webhookConfigs = $driver['webhook'];

            if(!$webhookConfigs['enabled']) {
                continue;
            }

            $controllerClass = $webhookConfigs['controller'];

            if(!in_array(HandleWebhookCallbacks::class, class_implements($controllerClass))) {
                throw new \Exception("Class {$controllerClass} does not implement HandleWebhookCallbacks");
            }

            Route::{$webhookConfigs['method']}(
                $webhookConfigs['uri'],
                [$controllerClass, 'handle']
            );
        }
    }
}
